{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openbot-auth-api",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker-entry.ts",
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "observability": {
    "enabled": false
  },
  "upload_source_maps": false,
  "triggers": {
    "crons": ["*/5 * * * *", "*/1 * * * *"]
  },
  "routes": [
    {
      "pattern": "jujurly.id",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "SKILLS_ADMIN_TOKEN",
      "REMOTE_TICKET_PRIVATE_JWK",
      "REMOTE_TICKET_PUBLIC_JWKS",
      "REMOTE_AUTH_WEBHOOK_SECRET",
      "STORAGE_S3_ACCESS_KEY_ID",
      "STORAGE_S3_SECRET_ACCESS_KEY",
      "KIRIMI_SECRET",
      "KIRIMI_WEBHOOK_SECRET",
      "ORG_VAULT_KEY"
    ]
  },
  "vars": {
    "STORAGE_S3_ENDPOINT": "https://kencana.basic.box.cloudeka.id",
    "STORAGE_S3_REGION": "auto",
    "STORAGE_S3_BUCKET": "surveykita-bucket-fndq9h",
    "STORAGE_S3_FORCE_PATH_STYLE": "true",
    "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
    "KIRIMI_USER_CODE": "KMYH501126",
    "KIRIMI_DEVICE_ID": "cd98b621193f6d1509f0885969a43b1496fe2dbd438f726b9091725d85d71a3b",
    "KIRIMI_WABA_NUMBER": "6287866245053",
    "OWNER_WHATSAPP_NUMBERS": "6281221386406",
    "REMOTE_TICKET_KEY_ID": "openbot-remote-1",
    "REMOTE_SIGNAL_URL": "",
    "REMOTE_SIGNAL_HOMES": "",
    "REMOTE_SIGNAL_HOME_LOCATIONS": "",
    "REMOTE_SIGNAL_HOME_COUNTRIES": "",
    "REMOTE_AUTH_WEBHOOK_URL": "",
    "REMOTE_AUTH_WEBHOOK_URLS": "",
    "FEEDBACK_WITHDRAWN_REPOSITORY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbot-auth",
      "database_id": "5333678f-abb8-43bd-8fde-55d713f88a23",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "MARKETPLACE_INGRESS_RATE_LIMITER",
      "namespace_id": "2026082701",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "MARKETPLACE_MUTATION_RATE_LIMITER",
      "namespace_id": "2026082702",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "MARKETPLACE_UPLOAD_RATE_LIMITER",
      "namespace_id": "2026082703",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "GITHUB_TOKEN_RATE_LIMITER",
      "namespace_id": "2026092911",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "LIVE_ACTIVITY_RATE_LIMITER",
      "namespace_id": "2026092901",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "2026110801",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "env": {
    "preview": {
      "name": "openbot-landing-preview",
